APP_NAME=LaundryTrack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
CENTRAL_DOMAINS=127.0.0.1,localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laundry_central
DB_USERNAME=laundry
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# GitHub Configuration
GITHUB_REPO=your-org/your-repo
GITHUB_TOKEN=

# Update System - Enable full file replacement for this specific device
AUTO_DEPLOY_CODE=false
ALLOW_TENANT_CODE_DEPLOY=false
AUTO_APPLY_UPDATES=false
REQUIRED_UPDATE_GRACE_PERIOD=7

PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=

SMS_API_BASE_URL=
SMS_API_ENDPOINT=/send/sms
SMS_API_TOKEN=
SMS_API_CONNECT_TIMEOUT=10
SMS_API_TIMEOUT=45
SMS_API_RETRY_TIMES=2
SMS_API_RETRY_SLEEP_MS=2000

# SMS_API_URL=https://api.smsapiph.com/send
# SMS_API_KEY=sk-2b10lzxiv1vhd6ykvu0bliopppteweva


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

